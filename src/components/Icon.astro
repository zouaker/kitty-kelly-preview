---
const {name='arrow',size=20,...rest}=Astro.props;
const paths:Record<string,string>={arrow:'M4 12h16m-6-6 6 6-6 6',external:'M6 18 18 6M6 6h12v12',download:'M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4',close:'m6 6 12 12M6 18 18 6',previous:'M6 5v14m12-14-9 7 9 7V5',next:'M18 5v14M6 5l9 7-9 7V5'};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...rest}>{name==='play'?<path d="m9 5 11 7-11 7V5Z" fill="currentColor" stroke="none"/>:name==='pause'?<path d="M8 5v14M16 5v14" stroke-width="3"/>:<path d={paths[name]||paths.arrow}/>}</svg>
