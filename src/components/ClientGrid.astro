---
const {items,title='Some familiar names.',eyebrow='SELECTED CLIENTS'}=Astro.props;
---
<section class="section client-section"><div class="section-heading"><div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div></div><div class="client-grid">{items.slice(0,10).map((item:any)=><figure><img src={item.image} width="250" height="130" loading="lazy" alt={item.name}/><figcaption>{item.name}</figcaption></figure>)}</div>{items.length>10&&<details class="more-clients"><summary>View {items.length-10} more clients <span aria-hidden="true">+</span></summary><div class="client-grid">{items.slice(10).map((item:any)=><figure><img src={item.image} width="250" height="130" loading="lazy" alt={item.name}/><figcaption>{item.name}</figcaption></figure>)}</div></details>}</section>
