---
import { tracks } from '../data/site';
import Icon from './Icon.astro';
const {ids=tracks.slice(0,6).map(t=>t.id), compact=false}=Astro.props;
const selected=ids.map((id:string)=>tracks.find(t=>t.id===id)).filter(Boolean);
---
<div class:list={['reel-list',{compact}]}>
 {selected.map((t:any,i:number)=><div class="reel-row" data-reel={t.id}>
  <span class="track-number">{String(i+1).padStart(2,'0')}</span>
  <button class="reel-main" type="button" data-track={t.id} aria-label={`Play ${t.title}`} aria-pressed="false"><span class="play-circle"><Icon name="play"/><span class="pause-icon"><Icon name="pause"/></span></span><span class="reel-copy"><strong>{t.title}</strong><span>{t.detail}</span></span></button>
  <span class="track-kind">MP3</span><a class="download" href={'/media/'+t.file} download aria-label={`Download ${t.title} MP3`}><Icon name="download"/></a>
  <noscript><audio controls preload="none" src={'/media/'+t.file} aria-label={t.title}></audio></noscript>
 </div>)}
</div>
