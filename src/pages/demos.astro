---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import ReelList from '../components/ReelList.astro';

import Icon from '../components/Icon.astro';
---
<Layout title="Voice Demos & Downloads" description="Listen to and download Kitty Kelly’s British voiceover demos: commercials, corporate, eLearning, audiobooks, audioguides, characters and documentary narration.">
 <PageHero label="The demo collection" title="Find your" accent="feeling." intro="Start with a voice. Discover the possibilities. Listen, explore and take a reel with you." image="/media/concepts/desk-close-1200.webp" action="#reels" actionLabel="Listen to the demos" compact/>
 <section class="section demos-section" id="reels"><div class="section-intro"><p class="eyebrow">A LITTLE RANGE. A LOT OF PERSONALITY.</p><h2>One voice.<br/><em>Take your pick.</em></h2><p>A natural London-Estuary accent.<br/>A whole range of characters and moods.</p><a class="text-link" href={withBase("/contact")}>Request an audition <Icon size={18}/></a></div><div class="demo-content"><div class="list-heading"><span>CHOOSE A REEL</span><span>LISTEN / DOWNLOAD</span></div><ReelList/><p class="quiet-note">Looking for a longer read? <a href={withBase("/audiobooks")}>Explore all seven audiobook samples.</a></p></div></section>
 <ProjectCTA/>
</Layout>
