---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';

import Icon from '../components/Icon.astro';
---
<Layout title="Voice Demos & Downloads" description="Listen to and download Kitty Kelly’s British voiceover demos: commercials, corporate, eLearning, audiobooks, audioguides, characters and documentary narration.">
 <section class="inner-hero"><p class="eyebrow">THE DEMO COLLECTION</p><h1>Find your <em>feeling.</em></h1><p class="intro">Start with a voice. Discover the possibilities.<br/>Listen, explore and take a reel with you.</p></section>
 <section class="section demos-section"><div class="section-intro"><p class="eyebrow">A LITTLE RANGE. A LOT OF PERSONALITY.</p><h2>One voice.<br/><em>Take your pick.</em></h2><p>A natural London-Estuary accent.<br/>A whole range of characters and moods.</p><a class="text-link" href={withBase("/contact")}>Request an audition <Icon size={18}/></a></div><div class="demo-content"><div class="list-heading"><span>CHOOSE A REEL</span><span>LISTEN / DOWNLOAD</span></div><ReelList/><p class="quiet-note">Looking for a longer read? <a href={withBase("/audiobooks")}>Explore all seven audiobook samples.</a></p></div></section>
</Layout>
