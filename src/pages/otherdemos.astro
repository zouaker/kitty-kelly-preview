---
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import {profile} from '../data/site';
import {accents} from '../data/portfolio';
---
<Layout title="Audioguide, Character & Documentary Demos" description="Explore Kitty Kelly’s audioguide, character, game and documentary narration demos, with MP3 downloads, accents and project credits.">
 <section class="inner-hero"><p class="eyebrow">MORE WAYS TO TELL A STORY</p><h1>Different worlds.<br/><em>The same human touch.</em></h1><p class="intro">Audio tours, character voices and documentary narration.<br/>Come and explore the range.</p><nav class="page-jumps" aria-label="On this page"><a href="#audioguides">Audioguides ↓</a><a href="#characters">Characters & accents ↓</a><a href="#narration">Documentaries ↓</a></nav></section>
 <section class="section other-category" id="audioguides"><div><p class="eyebrow">01 / AUDIOGUIDES</p><h2>A voice to <em>explore with.</em></h2><p>My tours include The National Gallery in London, the Museo del Prado in Madrid and Rome’s Colosseum. I’ve recorded for cultural destinations across the UK, France, Italy, Germany and Spain.</p><p>A warm, accessible delivery helps visitors find their way into a subject. I’m also comfortable with foreign names and terms, especially in Spanish, Italian, French and German.</p><a class="text-link" href="/audioguides">Explore audioguide work <Icon name="external" size={17}/></a></div><ReelList ids={['audioguide']}/><div class="tour-gallery">{[{i:0,name:'Historic interiors'},{i:1,name:'The National Gallery'},{i:2,name:'Railway heritage'},{i:3,name:'Museo del Prado'},{i:4,name:'City tours'},{i:5,name:'The Colosseum'}].map(p=><figure><img src={'/media/portfolio/otherdemos-'+p.i+'.webp'} width="750" height="500" loading="lazy" alt={p.name}/><figcaption>{p.name}</figcaption></figure>)}</div></section>
 <section class="section other-category character-category" id="characters"><div><p class="eyebrow">02 / CHARACTERS & GAMES</p><h2>Meet a few <em>different sides.</em></h2><p>My character work includes Serena, a Roman Empress, in Sheldon Collins’ full-cast audiobook The Legend of Valentine. Audiobook narration gives me a constant opportunity to create and explore new voices.</p><a class="text-link" href="/characters">Characters, games & dubbing <Icon name="external" size={17}/></a></div><ReelList ids={['character']}/><div class="accent-collection"><h3>A voice for the character.</h3><p>Frequently requested accents include West Country, Yorkshire, General American, Scottish and Cockney.</p><div class="tag-list">{accents.map(a=><span>{a}</span>)}</div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Full skills list on Spotlight <Icon name="external" size={16}/></a></div></section>
 <Testimonials type="characters"/>
 <section class="section other-category" id="narration"><div><p class="eyebrow">03 / DOCUMENTARIES & NARRATION</p><h2>Let the story <em>lead.</em></h2><p>A reel exploring different documentary and narration styles. For quieter storytelling, my work also includes guided meditation.</p><a class="text-link" href="/narration">Explore narration & meditations <Icon name="external" size={17}/></a></div><ReelList ids={['documentary']}/></section>
</Layout>
