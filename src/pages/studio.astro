---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import Icon from '../components/Icon.astro';
import StudioStory from '../components/StudioStory.astro';
---
<Layout title="Professional Voiceover Recording Studio" description="Kitty Kelly’s Valencia voiceover studio, with a SessionBooth, Lewitt LCT 540 S microphone and directed remote sessions via SourceConnect, Cleanfeed and Zoom.">
 <PageHero label="The studio" title="Good sound." accent="Great connection." intro="A dedicated recording studio in Valencia. A London base. Ready to connect with your team, wherever you’re listening." image="/media/concepts/studio-1440.webp" imageAlt="AI-enhanced concept based on Kitty’s original studio photographs" action="#studio-details" actionLabel="Explore the studio"/><nav class="page-route-nav" aria-label="On this page"><span>Inside the studio</span><a href="#studio-details">Recording & connection</a><a href="#equipment">Equipment</a><a href="#original-photos">Original photographs</a><a href={withBase('/contact')}>Book a session</a></nav>
 <StudioStory standalone/>
 <section class="section studio-grid" id="equipment"><figure class="studio-concept-photo"><picture><source srcset={withBaseSrcset("/media/concepts/booth-600.webp 600w, /media/concepts/booth-1000.webp 1000w")} sizes="(max-width:600px) 90vw, 44vw"/><img src={withBase("/media/concepts/booth-1000.webp")} width="1000" height="1250" alt="AI-enhanced concept of Kitty’s recording booth, based on her original photographs"/></picture><figcaption>AI-enhanced studio concept, subject to client approval.<br/><a href="#original-photos">See the original photographs below.</a></figcaption></figure><div><p class="eyebrow">BEHIND THE MIC</p><h2>Built for<br/><em>your words.</em></h2><ul class="equipment-list"><li>Recording space<span>SessionBooth double-wall vocal booth</span></li><li>Microphone<span>Lewitt LCT 540 S</span></li><li>Audio interface<span>Focusrite Scarlett Solo, 3rd Gen</span></li><li>Headphones<span>Beyerdynamic DT 770 PRO</span></li></ul><p class="studio-description">Join a directed session through SourceConnect, Cleanfeed, Zoom or SessionLink. For audiobooks, I can record using punch and roll.</p><a class="button dark-button" href={withBase("/contact")}>Talk about your session <Icon name="external" size={18}/></a></div></section>
 <section class="section studio-inperson"><div><p class="eyebrow">LET’S BE IN THE SAME ROOM</p><h2>Sometimes, it’s nice<br/><em>to get out of the booth.</em></h2></div><div><p>I work remotely with clients in the UK, US and Europe, and regularly return to my London base. In-house recordings can be arranged in the UK, Valencia and other Spanish cities, including Madrid and Barcelona.</p><a class="text-link" href={withBase("/contact")}>Discuss an in-person recording <Icon size={18}/></a></div></section>
 <section class="section studio-gallery-section" id="original-photos"><div class="section-heading"><div><p class="eyebrow">A LOOK AROUND</p><h2>The original <em>studio.</em></h2></div><p class="heading-aside">Kitty’s original photographs. The enhanced visuals above explore a new photographic direction for the same space.</p></div><div class="studio-gallery">{[1,2,3,4,5].map((i)=><img src={withBase('/media/portfolio/studio-'+i+'.webp')} width="750" height="750" loading="lazy" alt={['','Inside Kitty’s recording booth','The recording booth entrance','A corner of Kitty’s Valencia office','The booth in the recording space','Microphone and recording desk inside the booth'][i]}/>)}</div></section>
 <section class="section location-section"><figure><img src={withBase("/media/portfolio/studio-7.webp")} width="750" height="500" loading="lazy" alt="Valencia city skyline"/><figcaption><h3>Valencia</h3><p>My home studio, connected to the world.</p></figcaption></figure><figure><img src={withBase("/media/portfolio/studio-8.webp")} width="750" height="500" loading="lazy" alt="Tower Bridge and the London skyline"/><figcaption><h3>London</h3><p>My roots, and a base for in-person sessions.</p></figcaption></figure></section>
 <ProjectCTA/>
</Layout>
