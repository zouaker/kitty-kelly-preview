---
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Icon from '../components/Icon.astro';
import Recognition from '../components/Recognition.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoCard from '../components/VideoCard.astro';
import FAQ from '../components/FAQ.astro';
import {services,profile} from '../data/site';
import {videos,clients} from '../data/portfolio';
---
<Layout>
 <section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="small-rule"></span>BRITISH VOICEOVER & NARRATOR</p><h1>A voice with<br/><em>character.</em></h1><p class="hero-intro">Confident. Conversational. Full of life.<br/>I’m Kitty. A British voiceover artist bringing<br class="desktop-break"/> a little London charm to your next story.</p><div class="hero-actions"><button class="button lime" data-track="commercial" aria-label="Play commercial reel" aria-pressed="false"><Icon name="play" size={18}/> Hear my voice</button><a class="text-link" href="/contact">Let’s work together <Icon size={18}/></a></div><div class="hero-credentials"><span>Drama Studio London trained</span><span>90+ audiobooks narrated</span></div><div class="hero-footnote"><span>LONDON ROOTS. VALENCIA STUDIO.</span><a href="#demos" aria-label="Explore voice demos">EXPLORE THE REELS <span aria-hidden="true">↓</span></a></div></div><div class="hero-portrait"><picture><source srcset="/media/portrait-600.webp 600w, /media/portrait-1000.webp 1000w" sizes="(max-width: 600px) 90vw, 40vw" type="image/webp"/><img src="/media/portrait.jpg" width="1500" height="2134" fetchpriority="high" alt="Kitty Kelly, British voiceover artist and narrator"/></picture><div class="portrait-caption"><span>THE PERSON BEHIND THE VOICE</span><span class="signature">Hello, I’m Kitty.</span></div><button class="portrait-play" data-track="commercial" aria-label="Play Kitty’s commercial reel" aria-pressed="false"><Icon name="play" size={24}/><span>PRESS PLAY.<br/>MEET KITTY.</span></button></div></section>
 <section class="home-clients" aria-label="Selected clients"><p class="eyebrow">IN GOOD COMPANY</p>{[clients.commercials[0],clients.commercials[5],clients.commercials[8],clients.commercials[13],clients.corporates[8],clients.audiobooks[3]].map(c=><img src={c.image} width="180" height="75" alt={c.name} loading="lazy"/>)}</section>
 <section class="section demos-section" id="demos"><div class="section-intro"><p class="eyebrow">01 / THE VOICE</p><h2>Less reading.<br/><em>More listening.</em></h2><p>Find the feeling you’re looking for.<br/>A little range, a lot of personality.</p><a class="text-link" href="/demos">Explore all demos <Icon size={18}/></a><div class="demo-note"><strong>Your script, in my voice.</strong><p>Have a particular sound in mind? Get in touch to discuss a custom audition.</p></div></div><div class="demo-content"><div class="list-heading"><span>CHOOSE A REEL</span><span>LISTEN / DOWNLOAD</span></div><ReelList/><p class="quiet-note">From soft RP to down-to-earth London. <a href="/characters">Explore voices & accents.</a></p></div></section>
 <section class="work-section section" id="work"><div class="section-heading"><div><p class="eyebrow">02 / OUT IN THE WORLD</p><h2>You might have<br/><em>heard me here.</em></h2></div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Full credits on Spotlight <Icon name="external" size={18}/></a></div><div class="featured-work"><VideoCard video={videos[0]}/><a class="feature-book" href="/audiobooks"><div class="feature-book-art"><img src="/media/the-friendship-fling.jpg" width="400" height="400" loading="lazy" alt="The Friendship Fling by Georgia Stone"/></div><div><span class="eyebrow">AUDIOBOOK NARRATION</span><h3>The Friendship Fling</h3><p>Georgia Stone</p><span class="text-link">Meet the stories <Icon name="external" size={17}/></span></div></a></div><div class="work-notes"><a href="/corporates"><span class="eyebrow">CORPORATE</span><h3>Mango</h3><p>A corporate film exploring artificial intelligence.</p><Icon name="external"/></a><a href="/audioguides"><span class="eyebrow">AUDIOGUIDES</span><h3>The National Gallery</h3><p>A voice to guide you through the collection.</p><Icon name="external"/></a><a href="/characters"><span class="eyebrow">GAMES & CHARACTERS</span><h3>Clockwork Revolution</h3><p>Character work with inXile Entertainment.</p><Icon name="external"/></a></div></section>
 <Recognition/>
 <section class="services-section section" id="voiceover"><div class="section-intro"><p class="eyebrow">03 / A VOICE FOR YOUR WORLD</p><h2>One voice.<br/><em>Many possibilities.</em></h2><p>From a few unforgettable seconds<br/>to the very last chapter.</p><p class="service-support">Commercials, explainers, eLearning, English language training, audiobooks, audioguides, dubbing, games, meditations and documentary narration.</p></div><div class="service-list">{services.map((s,i)=><a href={'/'+s.slug}><span class="service-number">0{i+1}</span><div><h3>{s.name}</h3><p>{s.short}</p></div><Icon name="external" size={25}/></a>)}</div></section>
 <section class="about-section section"><div class="about-side"><p class="eyebrow">04 / A LITTLE ABOUT ME</p><h2>A London voice.<br/><em>A world of stories.</em></h2><p>I’m a British actress and voiceover artist, trained at Drama Studio London. I love finding the person behind the words, whether that’s a familiar voice for a brand or a completely new character.</p><p>My studio is in Valencia, with a base back in London. I work with teams in the UK, US and Europe, from my booth or in theirs.</p><div class="about-facts"><div><strong>90+</strong><span>Audiobooks narrated</span></div><div><strong>London<br/>Estuary</strong><span>My natural accent</span></div></div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Read my Spotlight CV <Icon name="external" size={18}/></a></div><figure class="about-photo"><img src="/media/portfolio/studio-7.webp" width="750" height="500" loading="lazy" alt="Valencia, home to Kitty’s recording studio"/><figcaption>A little Spanish sunshine. The same British voice.</figcaption><img class="about-detail" src="/media/portfolio/studio-6.webp" width="300" height="200" loading="lazy" alt="Oranges growing in Valencia"/></figure></section>
 <Testimonials/>
 <section class="home-studio section"><figure><img src="/media/portfolio/studio-4.webp" width="750" height="500" loading="lazy" alt="Kitty’s professional home recording studio"/></figure><div><p class="eyebrow">05 / READY WHEN YOU ARE</p><h2>Your team.<br/><em>My studio.</em></h2><p>A dedicated SessionBooth, a Lewitt microphone and remote connections that bring us into the same room.</p><div class="studio-connections"><span>SourceConnect</span><span>Cleanfeed</span><span>Zoom</span><span>SessionLink</span></div><a class="text-link" href="/studio">Step inside the studio <Icon size={18}/></a></div></section>
 <FAQ/>
</Layout>
