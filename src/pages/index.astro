---
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Icon from '../components/Icon.astro';
import Recognition from '../components/Recognition.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoCard from '../components/VideoCard.astro';
import FAQ from '../components/FAQ.astro';
import {services,profile} from '../data/site';
import {videos,clients} from '../data/portfolio';
---
<Layout>
 <section class="hero editorial-hero">
  <div class="hero-copy">
   <p class="eyebrow">KITTY KELLY / BRITISH VOICEOVER & NARRATOR</p>
   <h1>A voice you<br/><em>lean in</em><br/> to.</h1>
   <div class="hero-bottom"><p class="hero-intro">A little London charm.<br/>A whole lot of character.<br/>Let’s bring your words to life.</p><div class="hero-actions"><button class="button lime" data-track="commercial" aria-label="Play commercial reel" aria-pressed="false"><Icon name="play" size={18}/> Hear my voice</button><a class="text-link" href="/contact">Tell me your story <Icon size={18}/></a></div></div>
  </div>
  <div class="hero-portrait"><picture><source srcset="/media/portrait-600.webp 600w, /media/portrait-1000.webp 1000w" sizes="(max-width: 600px) 90vw, 40vw" type="image/webp"/><img src="/media/portrait.jpg" width="1500" height="2134" fetchpriority="high" alt="Kitty Kelly, British voiceover artist and narrator"/></picture><div class="portrait-caption"><span>LONDON ROOTS. VALENCIA STUDIO.</span></div><span class="portrait-note">Hello,<br/><em>I’m Kitty.</em></span></div>
  <div class="hero-baseline"><span>ACTOR. STORYTELLER. YOUR NEXT VOICE.</span><a href="#demos">Take a listen <span aria-hidden="true">↓</span></a></div>
 </section>
 <nav class="chapter-nav" aria-label="Explore this page"><span>KITTY / IN A FEW WORDS</span><a href="#demos">01 Listen</a><a href="#work">02 The work</a><a href="#about">03 Meet Kitty</a><a href="#studio">04 The studio</a><a href="/contact">Let’s talk <Icon name="external" size={16}/></a></nav>
 <section class="home-clients" aria-label="Selected clients"><p class="eyebrow">A FEW FAMILIAR NAMES</p>{[clients.commercials[0],clients.commercials[5],clients.commercials[8],clients.commercials[13],clients.corporates[8],clients.audiobooks[3]].map(c=><img src={c.image} width="180" height="75" alt={c.name} loading="lazy"/>)}</section>
 <section class="section demos-section" id="demos">
  <div class="section-intro"><p class="eyebrow">01 / FIND YOUR SOUND</p><h2>Good things<br/>start with<br/><em>a listen.</em></h2><p>Six ways into my world.<br/>Choose the voice for yours.</p><a class="text-link" href="/demos">All reels & downloads <Icon size={18}/></a><div class="demo-note"><strong>Something more specific?</strong><p>Send your script and let’s talk about a custom audition.</p></div></div>
  <div class="demo-content"><div class="list-heading"><span>THE DEMO COLLECTION</span><span>PRESS PLAY</span></div><ReelList showServices/><p class="quiet-note">Commercials, explainers, eLearning, ELT, audiobooks, tours, games, dubbing, meditations and documentaries. <a href="/otherdemos">Explore the range.</a></p></div>
 </section>
 <section class="work-section section" id="work"><div class="section-heading"><div><p class="eyebrow">02 / THE WORK</p><h2>Words out<br/><em>in the world.</em></h2></div><p class="work-intro">From the first impression<br/>to the final chapter.<a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Full credits on Spotlight <Icon name="external" size={18}/></a></p></div>
  <div class="featured-work"><div class="featured-commercial"><span class="project-index">01 / COMMERCIAL</span><VideoCard video={videos[0]}/><a class="text-link project-link" href="/commercials">More commercial work <Icon size={18}/></a></div><a class="feature-book" href="/audiobooks"><span class="project-index">02 / AUDIOBOOK</span><div class="feature-book-art"><img src="/media/the-friendship-fling.jpg" width="400" height="400" loading="lazy" alt="The Friendship Fling by Georgia Stone"/></div><div class="feature-book-caption"><h3>The Friendship Fling</h3><p>Georgia Stone</p><span class="text-link">Meet the stories <Icon name="external" size={17}/></span></div></a></div>
  <div class="work-notes"><a href="/corporates"><span class="eyebrow">03 / CORPORATE</span><h3>Mango</h3><p>A corporate film exploring artificial intelligence.</p><Icon name="external"/></a><a href="/audioguides"><span class="eyebrow">04 / AUDIOGUIDES</span><h3>The National Gallery</h3><p>A voice to guide you through the collection.</p><Icon name="external"/></a><a href="/characters"><span class="eyebrow">05 / GAMES & CHARACTERS</span><h3>Clockwork Revolution</h3><p>Character work with inXile Entertainment.</p><Icon name="external"/></a></div>
 </section>
 <section class="about-section section" id="about"><div class="about-side"><p class="eyebrow">03 / THE PERSON BEHIND THE VOICE</p><h2>London soul.<br/><em>Spanish sun.</em></h2><p>I’m Kitty, a British actress and voiceover artist, trained at Drama Studio London. I love finding the person behind the words, whether that’s a familiar voice for a brand or a completely new character.</p><p>My studio is in Valencia, with a base back in London. I work with teams in the UK, US and Europe, from my booth or in theirs.</p><div class="about-facts"><div><strong>90+</strong><span>Audiobooks narrated</span></div><div><strong>London<br/>Estuary</strong><span>My natural accent</span></div></div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Read my Spotlight CV <Icon name="external" size={18}/></a></div><figure class="about-photo"><img src="/media/portfolio/studio-7.webp" width="750" height="500" loading="lazy" alt="Valencia, home to Kitty’s recording studio"/><figcaption>A little Spanish sunshine. The same British voice.</figcaption><img class="about-detail" src="/media/portfolio/studio-6.webp" width="300" height="200" loading="lazy" alt="Oranges growing in Valencia"/></figure></section>
 <Recognition/>
 <Testimonials/>
 <section class="home-studio section" id="studio"><figure><img src="/media/portfolio/studio-4.webp" width="750" height="500" loading="lazy" alt="Kitty’s professional home recording studio"/><figcaption>THE BOOTH / VALENCIA, SPAIN</figcaption></figure><div><p class="eyebrow">04 / LET’S MAKE IT HAPPEN</p><h2>Different places.<br/><em>Same room.</em></h2><p>A dedicated SessionBooth, a Lewitt microphone and remote connections that bring us together for the recording.</p><div class="studio-connections"><span>SourceConnect</span><span>Cleanfeed</span><span>Zoom</span><span>SessionLink</span></div><a class="text-link" href="/studio">Step inside the studio <Icon size={18}/></a><a class="studio-enquiry" href="/contact">Have a project in mind? Let’s talk.</a></div></section>
 <FAQ/>
</Layout>

