---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Icon from '../components/Icon.astro';
import Recognition from '../components/Recognition.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoCard from '../components/VideoCard.astro';
import FAQ from '../components/FAQ.astro';
import ClientRibbon from '../components/ClientRibbon.astro';
import StudioStory from '../components/StudioStory.astro';
import {services,profile} from '../data/site';
import {videos} from '../data/portfolio';
const projects=[
 {id:'clairol',label:'Clairol',category:'Commercial',title:'A familiar voice. A fresh feeling.',description:'British voiceover for Clairol Nice’n Easy’s sponsorship of The Honesty Box.',link:'/commercials',cta:'Explore commercial work',video:videos[0]},
 {id:'linx',label:'Linx',category:'Corporate',title:'Complex ideas, made clear.',description:'An explainer for Linx laser coding technology. Approachable narration to help a business tell its story.',link:'/corporates',cta:'Explore corporate work',video:videos.find(v=>v.title.includes('Linx'))},
 {id:'friendship',label:'The Friendship Fling',category:'Audiobook',title:'One voice. A world to get lost in.',description:'The Friendship Fling by Georgia Stone. Part of a growing catalogue of more than 90 audiobooks.',link:'/audiobooks',cta:'Explore the audiobook collection',image:'/media/the-friendship-fling.jpg'}
];
---
<Layout>
 <section class="portrait-stage" aria-labelledby="opening-title">
  <span class="portrait-stage-name" aria-hidden="true">kitty kelly</span>
  <picture class="portrait-stage-image"><source srcset={withBaseSrcset('/media/portrait-cutout-600.webp 600w, /media/portrait-cutout-1100.webp 1100w')} sizes="(max-width:700px) 115vw, 64vw" type="image/webp"/><img src={withBase('/media/portrait-cutout-1100.webp')} width="1100" height="1566" fetchpriority="high" alt="Kitty Kelly, British voiceover artist and narrator"/></picture>
  <div class="portrait-stage-shade" aria-hidden="true"></div>
  <div class="portrait-stage-content">
   <div class="portrait-stage-copy"><p class="eyebrow">BRITISH VOICEOVER ARTIST & NARRATOR</p><h1 id="opening-title">A voice with<br/>a world of<br/><em>character.</em></h1><p class="stage-intro">Warmth. Wit. A little London spirit.<br/>Let’s bring your words to life.</p><div class="stage-actions"><a class="button lime" href={withBase('/contact')}>Let’s talk about your project <Icon name="external" size={18}/></a><a href="#about" class="stage-about">Meet Kitty <Icon name="external" size={16}/></a></div></div>
   <div class="stage-listen"><p class="eyebrow">A FIRST IMPRESSION</p><h2>Take a <em>listen.</em></h2><ReelList ids={['commercial','corporate','audiobook']} compact/><a class="stage-all-reels" href="#demos">Explore all six voice categories <Icon size={17}/></a></div>
  </div>
  <div class="stage-baseline"><span>LONDON ROOTS · VALENCIA STUDIO · CONNECTED WORLDWIDE</span><a href="#demos">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
 </section>
 <ClientRibbon/>
 <nav class="chapter-nav" aria-label="Explore this page"><span>ON THIS PAGE</span><a href="#demos">Listen</a><a href="#work">Selected work</a><a href="#about">Meet Kitty</a><a href="#studio">The studio</a><a href={withBase('/contact')}>Start a conversation <Icon name="external" size={15}/></a></nav>
 <section class="section listening-section" id="demos"><div class="section-heading"><div><p class="eyebrow">01 / THE VOICE COLLECTION</p><h2>Find the feeling.<br/><em>Press play.</em></h2></div><div class="heading-aside"><p>From a few unforgettable seconds<br/>to a story you can’t put down.</p><a class="text-link" href={withBase('/demos')}>All reels & downloads <Icon size={18}/></a></div></div><ReelList showServices/><div class="collection-bottom"><p>Commercials, explainers, eLearning, ELT, audiobooks, tours, games, dubbing, meditations and documentaries.</p><a href={withBase('/otherdemos')}>Explore the full range <Icon name="external" size={17}/></a></div></section>
 <section class="section selected-section" id="work"><div class="section-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2>You may have<br/><em>heard me here.</em></h2></div><a class="text-link" href={withBase('/work')}>Explore selected work <Icon name="external" size={18}/></a></div><div class="project-selector" aria-label="Choose a featured project" hidden>{projects.map((p,i)=><button type="button" data-project-choice={p.id} aria-pressed={i===0?'true':'false'} aria-controls={'project-'+p.id}><span>0{i+1}</span>{p.label}<Icon name="external" size={16}/></button>)}</div><div class="project-stage">{projects.map(p=><article id={'project-'+p.id} class="project-panel" data-project-panel={p.id}><div class:list={['project-media',{'project-book':!!p.image}]}>{p.video?<VideoCard video={p.video}/>:<img src={withBase(p.image!)} alt="The Friendship Fling by Georgia Stone, narrated by Kitty Kelly" width="400" height="400" loading="lazy"/>}</div><div class="project-story"><p class="eyebrow">{p.category} / {p.label}</p><h3>{p.title}</h3><p>{p.description}</p><a class="text-link" href={withBase(p.link)}>{p.cta}<Icon size={18}/></a></div></article>)}</div><div class="work-notes"><a href={withBase('/audioguides')}><span class="eyebrow">AUDIOGUIDES</span><h3>The National Gallery</h3><p>A voice to guide you through the collection.</p><Icon name="external"/></a><a href={withBase('/characters')}><span class="eyebrow">GAMES & CHARACTERS</span><h3>Clockwork Revolution</h3><p>Character work with inXile Entertainment.</p><Icon name="external"/></a><a href={withBase('/narration')}><span class="eyebrow">DOCUMENTARY & NARRATION</span><h3>Space for the story.</h3><p>Thoughtful reads, from documentaries to meditations.</p><Icon name="external"/></a></div></section>
 <section class="section meet-section" id="about"><div class="meet-images"><img class="meet-city" src={withBase('/media/portfolio/studio-7.webp')} width="750" height="500" loading="lazy" alt="Valencia, home to Kitty’s recording studio"/><img class="meet-oranges" src={withBase('/media/portfolio/studio-6.webp')} width="300" height="200" loading="lazy" alt="Oranges growing in Valencia"/><span class="meet-label">LONDON SOUL. SPANISH SUN.</span></div><div class="about-side"><p class="eyebrow">03 / A LITTLE ABOUT ME</p><h2>Actor by training.<br/>Storyteller <em>at heart.</em></h2><p>I’m Kitty, a British actress and voiceover artist, trained at Drama Studio London. I love finding the person behind the words, whether that’s a familiar voice for a brand or a completely new character.</p><p>My studio is in Valencia, with a base back in London. I work with teams in the UK, US and Europe, from my booth or in theirs.</p><div class="about-facts"><div><strong>90+</strong><span>Audiobooks narrated</span></div><div><strong>London Estuary</strong><span>My natural accent</span></div></div><a class="text-link" href={withBase('/about')}>More about Kitty <Icon name="external" size={18}/></a></div></section>
 <Recognition/>
 <StudioStory/>
 <Testimonials/>
 <section class="section process-section"><div class="section-heading"><div><p class="eyebrow">FROM YOUR FIRST IDEA TO THE FINAL READ</p><h2>Let’s make it<br/><em>sound like you.</em></h2></div><a class="button dark-button" href={withBase('/contact')}>Tell me about your project <Icon name="external" size={18}/></a></div><ol class="process-steps"><li><span>01</span><h3>Share the story.</h3><p>Send your script or outline, audience, usage and timings. We can talk through the tone and an audition.</p></li><li><span>02</span><h3>Find the feeling.</h3><p>Agree the brief, quote and session details. Join remotely to direct the read, or discuss an in-person recording.</p></li><li><span>03</span><h3>Bring it to life.</h3><p>Record the performance and agree the audio format and delivery details your production needs.</p></li></ol></section>
 <FAQ/>
</Layout>
