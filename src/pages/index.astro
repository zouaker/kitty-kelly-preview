---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Icon from '../components/Icon.astro';
import Recognition from '../components/Recognition.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoCard from '../components/VideoCard.astro';
import FAQ from '../components/FAQ.astro';
import {services,profile} from '../data/site';
import {videos,clients} from '../data/portfolio';
const projects=[
 {id:'clairol',label:'Clairol',category:'Commercial',title:'A familiar voice. A fresh feeling.',description:'British voiceover for Clairol Nice’n Easy’s sponsorship of The Honesty Box.',link:'/commercials',cta:'Explore commercial work',video:videos[0]},
 {id:'linx',label:'Linx',category:'Corporate',title:'Complex ideas, made clear.',description:'An explainer for Linx laser coding technology. Approachable narration to help a business tell its story.',link:'/corporates',cta:'Explore corporate work',video:videos.find(v=>v.title.includes('Linx'))},
 {id:'friendship',label:'The Friendship Fling',category:'Audiobook',title:'One voice. A world to get lost in.',description:'The Friendship Fling by Georgia Stone. Part of a growing catalogue of more than 90 audiobooks.',link:'/audiobooks',cta:'Explore the audiobook collection',image:'/media/the-friendship-fling.jpg'}
];
---
<Layout>
 <section class="opening" aria-labelledby="opening-title">
  <div class="opening-copy"><p class="eyebrow"><span class="record-dot" aria-hidden="true"></span> KITTY KELLY · BRITISH VOICEOVER ARTIST</p><h1 id="opening-title">The right voice.<br/>The real <em>feeling.</em></h1><p class="opening-intro">Warmth. Wit. A little London spirit.<br/>Voiceover and narration that bring your words to life.</p><div class="opening-actions"><a class="button dark-button" href={withBase('/contact')}>Let’s talk about your project <Icon name="external" size={18}/></a><a class="text-link" href="#demos">Explore my voice <Icon name="arrow" size={18}/></a></div><div class="opening-listen"><div class="list-heading"><span>A FIRST IMPRESSION</span><a href={withBase('/demos')}>All demos <span aria-hidden="true">↗</span></a></div><ReelList ids={['commercial','corporate','audiobook']} compact/></div><p class="opening-location">London roots <span aria-hidden="true">/</span> Valencia studio <span aria-hidden="true">/</span> Connected worldwide</p></div>
  <figure class="opening-portrait"><picture><source srcset={withBaseSrcset('/media/portrait-600.webp 600w, /media/portrait-1000.webp 1000w')} sizes="(max-width: 650px) 100vw, 44vw" type="image/webp"/><img src={withBase('/media/portrait.jpg')} width="1500" height="2134" fetchpriority="high" alt="Kitty Kelly, British voiceover artist and audiobook narrator"/></picture><figcaption><span>THE PERSON BEHIND THE VOICE</span><strong>Hello, I’m <em>Kitty.</em></strong></figcaption><a class="portrait-about" href="#about" aria-label="Meet Kitty"><Icon name="external" size={24}/></a></figure>
 </section>
 <section class="home-clients" aria-label="Selected clients"><p class="eyebrow">IN GOOD<br/>COMPANY</p>{[clients.commercials[0],clients.commercials[5],clients.commercials[8],clients.commercials[13],clients.corporates[8],clients.audiobooks[3]].map(c=><img src={withBase(c.image)} width="180" height="75" alt={c.name} loading="lazy"/>)}</section>
 <nav class="chapter-nav" aria-label="Explore this page"><span>A VOICE. MANY POSSIBILITIES.</span><a href="#demos">Listen</a><a href="#work">Selected work</a><a href="#about">Meet Kitty</a><a href="#studio">The studio</a><a href={withBase('/contact')}>Start a conversation <Icon name="external" size={15}/></a></nav>
 <section class="section listening-section" id="demos"><div class="section-heading"><div><p class="eyebrow">01 / THE VOICE COLLECTION</p><h2>Find the feeling.<br/><em>Press play.</em></h2></div><div class="heading-aside"><p>From a few unforgettable seconds<br/>to a story you can’t put down.</p><a class="text-link" href={withBase('/demos')}>All reels & downloads <Icon size={18}/></a></div></div><ReelList showServices/><div class="collection-bottom"><p>Commercials, explainers, eLearning, ELT, audiobooks, tours, games, dubbing, meditations and documentaries.</p><a href={withBase('/otherdemos')}>Explore the full range <Icon name="external" size={17}/></a></div></section>
 <section class="section selected-section" id="work"><div class="section-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2>You may have<br/><em>heard me here.</em></h2></div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Full credits on Spotlight <Icon name="external" size={18}/></a></div><div class="project-selector" aria-label="Choose a featured project" hidden>{projects.map((p,i)=><button type="button" data-project-choice={p.id} aria-pressed={i===0?'true':'false'} aria-controls={'project-'+p.id}><span>0{i+1}</span>{p.label}<Icon name="external" size={16}/></button>)}</div><div class="project-stage">{projects.map(p=><article id={'project-'+p.id} class="project-panel" data-project-panel={p.id}><div class:list={['project-media',{'project-book':!!p.image}]}>{p.video?<VideoCard video={p.video}/>:<img src={withBase(p.image!)} alt="The Friendship Fling by Georgia Stone, narrated by Kitty Kelly" width="400" height="400" loading="lazy"/>}</div><div class="project-story"><p class="eyebrow">{p.category} / {p.label}</p><h3>{p.title}</h3><p>{p.description}</p><a class="text-link" href={withBase(p.link)}>{p.cta}<Icon size={18}/></a></div></article>)}</div><div class="work-notes"><a href={withBase('/audioguides')}><span class="eyebrow">AUDIOGUIDES</span><h3>The National Gallery</h3><p>A voice to guide you through the collection.</p><Icon name="external"/></a><a href={withBase('/characters')}><span class="eyebrow">GAMES & CHARACTERS</span><h3>Clockwork Revolution</h3><p>Character work with inXile Entertainment.</p><Icon name="external"/></a><a href={withBase('/narration')}><span class="eyebrow">DOCUMENTARY & NARRATION</span><h3>Space for the story.</h3><p>Thoughtful reads, from documentaries to meditations.</p><Icon name="external"/></a></div></section>
 <section class="section meet-section" id="about"><div class="meet-images"><img class="meet-city" src={withBase('/media/portfolio/studio-7.webp')} width="750" height="500" loading="lazy" alt="Valencia, home to Kitty’s recording studio"/><img class="meet-oranges" src={withBase('/media/portfolio/studio-6.webp')} width="300" height="200" loading="lazy" alt="Oranges growing in Valencia"/><span class="meet-label">LONDON SOUL. SPANISH SUN.</span></div><div class="about-side"><p class="eyebrow">03 / A LITTLE ABOUT ME</p><h2>Actor by training.<br/>Storyteller <em>at heart.</em></h2><p>I’m Kitty, a British actress and voiceover artist, trained at Drama Studio London. I love finding the person behind the words, whether that’s a familiar voice for a brand or a completely new character.</p><p>My studio is in Valencia, with a base back in London. I work with teams in the UK, US and Europe, from my booth or in theirs.</p><div class="about-facts"><div><strong>90+</strong><span>Audiobooks narrated</span></div><div><strong>London Estuary</strong><span>My natural accent</span></div></div><a class="text-link" href={profile.spotlight} target="_blank" rel="noopener noreferrer">Get to know my work <Icon name="external" size={18}/></a></div></section>
 <Recognition/>
 <section class="studio-feature" id="studio"><div class="studio-feature-copy"><p class="eyebrow">04 / YOUR SESSION, MY STUDIO</p><h2>A small space.<br/><em>Big possibilities.</em></h2><p>A dedicated booth in Valencia. A direct connection to your team. Let’s find the performance together, wherever you are.</p><div class="studio-connections"><span>SourceConnect</span><span>Cleanfeed</span><span>Zoom</span><span>SessionLink</span></div><a class="button lime" href={withBase('/studio')}>Step inside the studio <Icon name="external" size={18}/></a></div><figure class="studio-feature-image"><picture><source srcset={withBaseSrcset('/media/concepts/studio-750.webp 750w, /media/concepts/studio-1440.webp 1440w')} sizes="(max-width:850px) 100vw, 60vw"/><img src={withBase('/media/concepts/studio-1440.webp')} width="1440" height="960" loading="lazy" alt="AI-enhanced concept of Kitty’s Valencia studio, based on the original room photographs"/></picture><figcaption>AI-enhanced studio concept · <a href={withBase('/studio/#original-photos')}>View original photography</a></figcaption></figure></section>
 <Testimonials/>
 <section class="section process-section"><div class="section-heading"><div><p class="eyebrow">FROM YOUR FIRST IDEA TO THE FINAL READ</p><h2>Let’s make it<br/><em>sound like you.</em></h2></div><a class="button dark-button" href={withBase('/contact')}>Tell me about your project <Icon name="external" size={18}/></a></div><ol class="process-steps"><li><span>01</span><h3>Share the story.</h3><p>Send your script or outline, audience, usage and timings. We can talk through the tone and an audition.</p></li><li><span>02</span><h3>Find the feeling.</h3><p>Agree the brief, quote and session details. Join remotely to direct the read, or discuss an in-person recording.</p></li><li><span>03</span><h3>Bring it to life.</h3><p>Record the performance and agree the audio format and delivery details your production needs.</p></li></ol></section>
 <FAQ/>
</Layout>
