---
import {withBase,withBaseSrcset} from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import ReelList from '../components/ReelList.astro';
import Icon from '../components/Icon.astro';
import ClientGrid from '../components/ClientGrid.astro';
import VideoCard from '../components/VideoCard.astro';
import Recognition from '../components/Recognition.astro';
import Testimonials from '../components/Testimonials.astro';
import {services,profile,origin} from '../data/site';
import {clients,videos,books,accents,genres} from '../data/portfolio';
export function getStaticPaths(){return services.map(service=>({params:{service:service.slug},props:{service}}));}
const {service:s}=Astro.props;
const schema={'@context':'https://schema.org','@type':'Service',name:s.name+' voiceover',description:s.intro,url:new URL(s.slug,origin+'/').href,provider:{'@type':'Person',name:'Kitty Kelly'}};
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:origin},{'@type':'ListItem',position:2,name:s.name,item:new URL(s.slug,origin+'/').href}]};
const pageVideos=videos.filter(v=>s.slug==='commercials'?v.page==='commercials'||v.page==='home':v.page===s.slug);
const clientList=clients[s.slug as keyof typeof clients];
---
<Layout title={s.name+' Voiceover'} description={s.intro}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)}/><script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}/>
 <section class="inner-hero"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase("/")}>Home</a><span aria-hidden="true">/</span><span>{s.name}</span></nav><p class="eyebrow">BRITISH VOICEOVER / {s.name.toUpperCase()}</p><h1>{s.title}</h1><p class="intro">{s.intro}</p><div class="tag-list">{s.tags.map(t=><span>{t}</span>)}</div><nav class="page-jumps" aria-label="On this page"><a href="#listen">Listen ↓</a>{pageVideos.length>0&&<a href="#films">Watch the work ↓</a>}{s.slug==='audiobooks'&&<a href="#books">Browse the books ↓</a>}{clientList&&<a href="#clients">Clients ↓</a>}<a href={withBase("/contact")}>Discuss a project ↗</a></nav></section>
 <section class="service-body" id="listen"><div class="service-story"><h2>{s.secondary}</h2><p>{s.body}</p><p>{s.note}</p><a class="button dark-button" href={withBase('/contact?service='+encodeURIComponent(s.name))}>Discuss your project <Icon name="external" size={18}/></a><div class="next-services"><a href={withBase(profile.spotlight)} target="_blank" rel="noopener noreferrer">Full credits on Spotlight ↗</a>{s.slug==='audiobooks'&&<a href={withBase(profile.audible)} target="_blank" rel="noopener noreferrer">Browse Audible ↗</a>}</div></div><div class="service-listen"><p class="eyebrow">HEAR THE DIFFERENCE</p><ReelList ids={[s.track]}/><div class="listening-notes"><span>London Estuary · Soft RP · Character range</span><p>Listen to the reel or download the MP3 for your project shortlist.</p></div><p class="quiet-note">Have a script in mind? <a href={withBase("/contact")}>Ask about an audition.</a></p></div></section>
 {pageVideos.length>0&&<section class="section video-section" id="films"><div class="section-heading"><div><p class="eyebrow">THE VOICE IN CONTEXT</p><h2>{s.slug==='corporates'?'Ideas made clear.':s.slug==='characters'?'A whole new world.':'A few familiar moments.'}</h2></div><p>{s.slug==='characters'?'An official look at the world of Clockwork Revolution.':'Press play to explore the work.'}</p></div><div class="film-grid">{pageVideos.map(video=><VideoCard video={video} caption={s.slug==='characters'?'Official game trailer · not a character performance reel':undefined}/>)}</div><p class="quiet-note">Videos load from their original providers when you press play. Each film also has a direct source link.</p></section>}
 {s.slug==='corporates'&&<section class="section compact-feature"><img src={withBase("/media/portfolio/home-4.webp")} width="500" height="300" loading="lazy" alt="Mango"/><div><p class="eyebrow">ALSO IN THE PORTFOLIO</p><h2>Mango</h2><p>Corporate voiceover for a film about the brand’s use of artificial intelligence.</p></div></section>}
 {s.slug==='commercials'&&<section class="section compact-feature"><img src={withBase("/media/portfolio/home-3.webp")} width="500" height="300" loading="lazy" alt="Paw Patrol"/><div><p class="eyebrow">ALSO IN THE PORTFOLIO</p><h2>Paw Patrol</h2><p>Dubbing for a social media promotional video.</p></div></section>}
 {s.slug==='audiobooks'&&<><Recognition/><section class="section book-samples"><p class="eyebrow">THE SAMPLE LIBRARY</p><h2>A story for <em>every mood.</em></h2><ReelList ids={['audiobook','bennet','atoz','walker','constellations','noharm','children']}/></section><section class="section bookshelf-section" id="books"><div class="section-heading"><div><p class="eyebrow">ON THE BOOKSHELF</p><h2>Just a few of <em>the stories.</em></h2></div><a class="text-link" href={withBase(profile.audible)} target="_blank" rel="noopener noreferrer">More on Audible <Icon name="external" size={17}/></a></div><div class="book-grid"><figure><img src={withBase("/media/the-friendship-fling.jpg")} width="300" height="400" loading="lazy" alt="The Friendship Fling cover"/><figcaption><strong>The Friendship Fling</strong><span>Georgia Stone</span></figcaption></figure><figure><img src={withBase("/media/the-perfect-stranger.jpg")} width="300" height="400" loading="lazy" alt="The Perfect Stranger cover"/><figcaption><strong>The Perfect Stranger</strong><span>Tara Lyons</span></figcaption></figure>{books.map(book=><figure><img src={withBase(book.image)} width="300" height="400" loading="lazy" alt={book.title+' cover'}/><figcaption><strong>{book.title}</strong><span>{book.author}</span></figcaption></figure>)}</div><div class="genres"><p class="eyebrow">FROM ROM-COMS TO MURDER MYSTERIES</p><div class="tag-list">{genres.map(genre=><span>{genre}</span>)}</div></div><p class="quiet-note">Some titles are available only on Audible.com or Scribd. <a href={withBase(profile.spotlight)} target="_blank" rel="noopener noreferrer">See the full credit list on Spotlight.</a></p></section></>}
 {clientList&&<div id="clients"><ClientGrid items={clientList} title={s.slug==='audiobooks'?'Publishers & studios.':'In very good company.'} eyebrow={s.slug==='audiobooks'?'PUBLISHERS & RECORDING PARTNERS':'SELECTED CLIENTS'}/></div>}
 {(s.slug==='audiobooks'||s.slug==='characters')&&<section class="section accent-section"><div><p class="eyebrow">CHARACTER, IN EVERY SENSE</p><h2>A world of <em>accents.</em></h2><p>London Estuary and soft RP are my natural narration styles. These are accents I’ve used across narration and character work.</p></div><div class="tag-list">{accents.map(accent=><span>{accent}</span>)}</div></section>}
 {s.slug==='audioguides'&&<section class="section destinations"><div class="section-heading"><div><p class="eyebrow">A FEW PLACES I’VE TAKEN LISTENERS</p><h2>Stories, <em>everywhere.</em></h2></div></div><div class="destination-grid">{[{i:1,name:'The National Gallery',place:'London'},{i:3,name:'Museo del Prado',place:'Madrid'},{i:5,name:'The Colosseum',place:'Rome'}].map(d=><figure><img src={withBase('/media/portfolio/otherdemos-'+d.i+'.webp')} width="600" height="400" loading="lazy" alt={d.name}/><figcaption><h3>{d.name}</h3><p>{d.place}</p></figcaption></figure>)}</div></section>}
 {s.slug==='narration'&&<section class="section meditation-feature"><p class="eyebrow">A QUIETER KIND OF STORYTELLING</p><h2>Space to <em>pause.</em></h2><p>My meditation work includes Exploring & Processing Grief for Soul Readings.</p><a class="text-link" href="https://www.soul-readings.online/product-page/exploring-and-processing-grief-a-guided-experience-1" target="_blank" rel="noopener noreferrer">Explore the guided meditation <Icon name="external" size={18}/></a></section>}
 {(s.slug==='corporates'||s.slug==='audiobooks'||s.slug==='characters')&&<Testimonials type={s.slug}/>}
 <section class="section related-services"><p class="eyebrow">KEEP EXPLORING</p><div class="next-services">{services.filter(item=>item.slug!==s.slug).map(item=><a href={withBase('/'+item.slug)}>{item.name} ↗</a>)}</div></section>
</Layout>
