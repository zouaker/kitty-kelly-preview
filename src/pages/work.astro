---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VideoCard from '../components/VideoCard.astro';
import ReelList from '../components/ReelList.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import {videos,books} from '../data/portfolio';
import {profile} from '../data/site';
import {withBase} from '../lib/urls';
const commercial=videos.filter(v=>v.page==='home'||v.page==='commercials');
const corporate=videos.filter(v=>v.page==='corporates');
const game=videos.find(v=>v.page==='characters');
---
<Layout title="Selected Voiceover Work & Portfolio" description="Explore Kitty Kelly’s voiceover portfolio: commercial films, corporate explainers, audiobook narration, cultural audioguides and character work.">
 <PageHero label="Selected work" title="You may have" accent="heard me here." intro="Advertising, stories, ideas and imaginary worlds. A selection of the projects I’ve lent my voice to." image="/media/editorial/script-1440.webp" action="#commercial-work" actionLabel="Explore the portfolio"/>
 <nav class="page-route-nav" aria-label="Portfolio categories"><span>Browse the work</span><a href="#commercial-work">Commercials</a><a href="#corporate-work">Corporate</a><a href="#audiobook-work">Audiobooks</a><a href="#character-work">Characters & games</a><a href="#audioguide-work">Audioguides</a><a href="#narration-work">Narration</a></nav>
 <section class="work-category" id="commercial-work"><div class="section-heading"><div><p class="eyebrow">01 / COMMERCIALS</p><h2>A voice for<br/><em>the moment.</em></h2></div><p>From Clairol’s sponsorship of The Honesty Box to Arla, Sensodyne and Lucozade. Explore the original films below.</p></div><div class="film-grid">{commercial.map(video=><VideoCard video={video}/>)}</div><div class="work-category-footer"><a class="text-link" href={withBase('/commercials')}>Commercial demo & client list</a><span>Films load only when you press play.</span></div></section>
 <section class="work-category" id="corporate-work"><div class="section-heading"><div><p class="eyebrow">02 / CORPORATE & ELEARNING</p><h2>Ideas made<br/><em>clear.</em></h2></div><p>Explainers and business stories, with a clear, approachable delivery.</p></div><div class="film-grid">{corporate.map(video=><VideoCard video={video}/>)}</div><div class="work-category-footer"><a class="text-link" href={withBase('/corporates')}>Corporate, eLearning & ELT</a></div></section>
 <section class="work-category" id="audiobook-work"><div class="section-heading"><div><p class="eyebrow">03 / AUDIOBOOKS</p><h2>Stay for<br/><em>the story.</em></h2></div><p>More than 90 audiobooks, from romantic comedies to psychological thrillers, children’s stories and non-fiction.</p></div><div class="work-book-grid"><figure><img src={withBase('/media/the-friendship-fling.jpg')} width="300" height="400" loading="lazy" alt="The Friendship Fling book cover"/><figcaption>The Friendship Fling · Georgia Stone</figcaption></figure>{books.slice(0,3).map(book=><figure><img src={withBase(book.image)} width="300" height="400" loading="lazy" alt={book.title+' book cover'}/><figcaption>{book.title} · {book.author}</figcaption></figure>)}</div><div class="work-category-footer"><a class="text-link" href={withBase('/audiobooks')}>All seven narration samples & bookshelf</a><a href={profile.audible} target="_blank" rel="noopener noreferrer">Browse Audible</a></div></section>
 <section class="work-category" id="character-work"><div class="section-heading"><div><p class="eyebrow">04 / CHARACTERS & GAMES</p><h2>Someone<br/><em>entirely new.</em></h2></div><p>Character voices for inXile Entertainment’s Clockwork Revolution, and Serena in Sheldon Collins’ full-cast audiobook The Legend of Valentine.</p></div><div class="film-grid">{game&&<VideoCard video={game} caption="Official game trailer · not a character performance reel"/>}<div><p class="eyebrow">HEAR THE CHARACTER RANGE</p><ReelList ids={['character']}/><a class="text-link" href={withBase('/characters')}>Characters, games, dubbing & accents</a></div></div></section>
 <section class="work-category" id="audioguide-work"><div class="section-heading"><div><p class="eyebrow">05 / AUDIOGUIDES</p><h2>A voice to<br/><em>explore with.</em></h2></div><p>Tours for cultural destinations including The National Gallery, the Museo del Prado and the Colosseum.</p></div><div class="destination-grid">{[{i:1,name:'The National Gallery',place:'London'},{i:3,name:'Museo del Prado',place:'Madrid'},{i:5,name:'The Colosseum',place:'Rome'}].map(d=><figure><img src={withBase('/media/portfolio/otherdemos-'+d.i+'.webp')} width="600" height="400" loading="lazy" alt={d.name}/><figcaption><h3>{d.name}</h3><p>{d.place}</p></figcaption></figure>)}</div><div class="work-category-footer"><a class="text-link" href={withBase('/audioguides')}>Listen to the audioguide reel</a></div></section>
 <section class="work-category" id="narration-work"><div class="section-heading"><div><p class="eyebrow">06 / DOCUMENTARY & NARRATION</p><h2>Let the<br/><em>story lead.</em></h2></div><p>Explore the documentary reel, alongside meditation work including Exploring & Processing Grief for Soul Readings.</p></div><ReelList ids={['documentary']}/><div class="work-category-footer"><a class="text-link" href={withBase('/narration')}>Narration & meditation</a><a href={profile.spotlight} target="_blank" rel="noopener noreferrer">Full credits on Spotlight</a></div></section>
 <ProjectCTA title="What shall we make next?"/>
</Layout>
