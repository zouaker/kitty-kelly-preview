---
import {withBase,withBaseSrcset,routePath} from '../lib/urls';
import { ClientRouter } from 'astro:transitions';
import {profile,tracks,services,origin,preview} from '../data/site';
import Player from '../components/Player.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/edition.css';
import '../styles/portrait-stage.css';
import '../styles/refinements.css';
import '../styles/pages.css';
const { title='British Female Voiceover & Narrator', description='Kitty Kelly is a British voiceover artist and audiobook narrator. Hear commercial, corporate, audiobook and character demos, and get in touch about your project.', dark=false }=Astro.props;
const path=routePath(Astro.url.pathname);
const navigation=[['/','Home'],['/about','About Kitty'],['/voiceover','Voiceover'],['/work','Selected work'],['/demos','Demos'],['/studio','Studio']];
const voicePage=path==='/voiceover'||path==='/otherdemos'||services.some(s=>'/'+s.slug===path);
const canonical=new URL(path.slice(1),origin+'/').href;
const schema={ '@context':'https://schema.org','@type':'Person',name:profile.name,jobTitle:'Voiceover artist and audiobook narrator',url:origin,email:profile.email,sameAs:[profile.spotlight,profile.audible],knowsAbout:['Voice acting','Audiobook narration','Commercial voiceover'] };
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f7f3ec"/><title>{title} | Kitty Kelly</title><meta name="description" content={description}/><meta name="robots" content={preview?'noindex, nofollow':'index, follow'}/><link rel="canonical" href={withBase(canonical)}/><meta property="og:title" content={`${title} | Kitty Kelly`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('media/portrait.jpg',origin+'/').href}/><link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")}/><link rel="stylesheet" href={withBase("/fonts/fonts.css")}/><ClientRouter/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class:list={{'dark-top':dark}}><a class="skip-link" href="#main">Skip to content</a>
 <div class="contact-strip"><a href={'mailto:'+profile.email}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg>{profile.email}</a></div>
 <header class="site-header"><a class="wordmark" href={withBase('/')} aria-label="Kitty Kelly home">kitty kelly<span>VOICEOVER & NARRATOR</span></a>
 <nav class="desktop-nav" aria-label="Main navigation"><a href={withBase('/')} aria-current={path==='/'?'page':undefined}>Home</a><a href={withBase('/about')} aria-current={path==='/about'?'page':undefined}>About</a><details class:list={['service-menu','nav-disclosure',{'is-active':voicePage}]}><summary>Voiceover</summary><div><a href={withBase('/voiceover')} aria-current={path==='/voiceover'?'page':undefined}>Explore all voiceover services</a>{services.map(service=><a href={withBase('/'+service.slug)} aria-current={path==='/'+service.slug?'page':undefined}>{service.name}</a>)}<a href={withBase('/otherdemos')}>More demos & accents</a></div></details><a href={withBase('/work')} aria-current={path==='/work'?'page':undefined}>Selected work</a><a href={withBase('/demos')} aria-current={path==='/demos'?'page':undefined}>Demos</a><a href={withBase('/studio')} aria-current={path==='/studio'?'page':undefined}>Studio</a></nav>
 <a class="header-cta" href={withBase('/contact')}><span class="desktop-cta-label">Start your project</span><span class="mobile-cta-label">Let’s talk</span></a><details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation">{navigation.map(([href,label])=><a href={withBase(href)} aria-current={path===href?'page':undefined}>{label}</a>)}<a href={withBase('/otherdemos')}>More demos & accents</a><a href={withBase('/contact')}>Contact & representation</a></nav></details></header>
 <div class="reading-progress" aria-hidden="true"></div><main id="main"><slot/></main>
 <footer class="footer"><div class="footer-top"><div><p class="eyebrow">LET’S MAKE SOMETHING SOUND GOOD</p><a class="footer-invite" href={withBase("/contact")}>Your words.<br/><em>My voice.</em><Icon name="external" size={52}/></a></div><div class="footer-contact"><a href={withBase('mailto:'+profile.email)}>{profile.email}</a><a href="tel:+447769272056">{profile.phone}</a><p>London roots. Valencia studio.<br/>Connected wherever you are.</p><div class="social-links"><a href={withBase(profile.spotlight)} target="_blank" rel="noopener noreferrer">Spotlight <Icon name="external" size={16}/></a><a href={withBase(profile.audible)} target="_blank" rel="noopener noreferrer">Audible <Icon name="external" size={16}/></a></div></div></div><div class="footer-services"><a href={withBase("/")}>Home</a><a href={withBase("/about")}>About Kitty</a><a href={withBase("/work")}>Selected work</a><a href={withBase("/voiceover")}>All services</a>{services.map(s=><a href={withBase('/'+s.slug)}>{s.name}</a>)}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} Kitty Kelly</span><span>British voiceover. A world of character.</span><a href={withBase("/privacy")}>Privacy</a></div></footer>
 <Player/><script id="track-data" type="application/json" set:html={JSON.stringify(tracks)}/><script>import '../scripts/site';import '../scripts/motion';import '../scripts/projects';import '../scripts/refinements';</script>
</body></html>



