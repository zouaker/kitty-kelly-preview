---
import {withBase,withBaseSrcset,routePath} from '../lib/urls';
import { ClientRouter } from 'astro:transitions';
import {profile,tracks,services,origin,preview} from '../data/site';
import Player from '../components/Player.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/edition.css';
const { title='British Female Voiceover & Narrator', description='Kitty Kelly is a British voiceover artist and audiobook narrator. Hear commercial, corporate, audiobook and character demos, and get in touch about your project.', dark=false }=Astro.props;
const path=routePath(Astro.url.pathname);
const navigation=[['/','Home'],['/commercials','Commercials'],['/corporates','Corporate'],['/audiobooks','Audiobooks'],['/otherdemos','More demos'],['/studio','Studio']];
const canonical=new URL(path.slice(1),origin+'/').href;
const schema={ '@context':'https://schema.org','@type':'Person',name:profile.name,jobTitle:'Voiceover artist and audiobook narrator',url:origin,email:profile.email,sameAs:[profile.spotlight,profile.audible],knowsAbout:['Voice acting','Audiobook narration','Commercial voiceover'] };
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f8f7f3"/><title>{title} | Kitty Kelly</title><meta name="description" content={description}/><meta name="robots" content={preview?'noindex, nofollow':'index, follow'}/><link rel="canonical" href={withBase(canonical)}/><meta property="og:title" content={`${title} | Kitty Kelly`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('media/portrait.jpg',origin+'/').href}/><link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")}/><link rel="stylesheet" href={withBase("/fonts/fonts.css")}/><ClientRouter/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body class:list={{'dark-top':dark}}><a class="skip-link" href="#main">Skip to content</a>
 <header class="site-header"><a class="wordmark" href={withBase("/")} aria-label="Kitty Kelly home">kitty kelly<span>VOICEOVER & NARRATOR</span></a><nav class="desktop-nav" aria-label="Main navigation">{navigation.map(([href,label])=><a href={withBase(href)} aria-current={path===href?'page':undefined}>{label}</a>)}<a href={withBase("/demos")} aria-current={path==='/demos'?'page':undefined}>All reels</a></nav><a class="header-cta" href={withBase("/contact")}>Let’s talk <Icon name="external" size={17}/></a><details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation">{navigation.map(([href,label])=><a href={withBase(href)} aria-current={path===href?'page':undefined}>{label}</a>)}<a href={withBase("/demos")}>Listen to all demos</a><a href={withBase("/#work")}>Selected work</a><a href={withBase("/contact")}>Contact & representation</a></nav></details></header>
 <div class="reading-progress" aria-hidden="true"></div><main id="main"><slot/></main>
 <footer class="footer"><div class="footer-top"><div><p class="eyebrow">LET’S MAKE SOMETHING SOUND GOOD</p><a class="footer-invite" href={withBase("/contact")}>Your words.<br/><em>My voice.</em><Icon name="external" size={52}/></a></div><div class="footer-contact"><a href={withBase('mailto:'+profile.email)}>{profile.email}</a><a href="tel:+447769272056">{profile.phone}</a><p>London roots. Valencia studio.<br/>Connected wherever you are.</p><div class="social-links"><a href={withBase(profile.spotlight)} target="_blank" rel="noopener noreferrer">Spotlight <Icon name="external" size={16}/></a><a href={withBase(profile.audible)} target="_blank" rel="noopener noreferrer">Audible <Icon name="external" size={16}/></a></div></div></div><div class="footer-services"><a href={withBase("/")}>Home</a>{services.map(s=><a href={withBase('/'+s.slug)}>{s.name}</a>)}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} Kitty Kelly</span><span>British voiceover. A world of character.</span><a href={withBase("/privacy")}>Privacy</a></div></footer>
 <Player/><script id="track-data" type="application/json" set:html={JSON.stringify(tracks)}/><script>import '../scripts/site';import '../scripts/motion';</script>
</body></html>



